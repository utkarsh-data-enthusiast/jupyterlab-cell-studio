{
  "actions" : {
    "build" : {
      "enabled" : true,
      "script" : "npm run build"
    },
    "run" : {
      "enabled" : true,
      "script" : "export PYTHONPATH=\"$PWD${PYTHONPATH:+:$PYTHONPATH}\"\n\/Library\/Frameworks\/Python.framework\/Versions\/3.14\/bin\/jupyter-builder develop . --overwrite"
    }
  },
  "openLogOnRun" : "start"
}
